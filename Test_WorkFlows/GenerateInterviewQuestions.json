    {
      "parameters": {
        "jsCode": "// Get the AI response\nconst aiText = $json.content?.[0]?.text || \"\";\n\n// Remove markdown code fences if the AI added them\nlet cleaned = aiText\n  .replace(/```json\\s*/gi, \"\")\n  .replace(/```\\s*/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  return [\n    {\n      json: {\n        success: false,\n        jobTitle: $(\"Take Input\").first().json.jobTitle,\n        companyName: $(\"Take Input\").first().json.companyName,\n        questions: [],\n        error: \"Could not parse AI response\",\n        raw: aiText\n      }\n    }\n  ];\n}\n\nconst input = $(\"Take Input\").first().json;\n\nreturn [\n  {\n    json: {\n      success: true,\n      jobTitle: input.jobTitle,\n      companyName: input.companyName,\n      questions: parsed.questions || []\n    }\n  }\n];"
      },
      "id": "0eb43e8a-cd2e-4145-acfa-9557d2604286",

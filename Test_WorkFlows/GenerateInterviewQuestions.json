          "cachedResultName": "claude-opus-4-8"
        },
        "messages": {
          "values": [
            {
              "content": "You are an expert technical interviewer and career coach. Given a candidate's resume and a specific job description, generate realistic interview questions this candidate is likely to be asked for that role. Base the questions on the actual overlaps and gaps between the resume and the job description — do not produce generic filler.\n\nReturn ONLY valid JSON, with no markdown code fences and no commentary, in exactly this shape:\n{\"questions\":[{\"category\":\"Behavioral\",\"question\":\"...\"},{\"category\":\"Technical\",\"question\":\"...\"},{\"category\":\"Role-Specific\",\"question\":\"...\"}]}\n\nInclude exactly 3 Behavioral, 4 Technical, and 3 Role-Specific questions (10 total)."
            },
            {
              "content": "=Job Title: {{ $json.jobTitle }}\nCompany: {{ $json.companyName }}\n\nJob Description:\n{{ $json.jobDescription }}\n\nCandidate Resume:\n{{ $json.resumeContent }}\n\nGenerate the interview questions now, following the JSON format specified."
            }
          ]
        },
        "options": {
          "maxTokens": 30000
        }
      },

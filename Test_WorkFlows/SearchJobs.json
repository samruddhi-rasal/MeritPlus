    {
      "parameters": {
        "jsCode": "// Get all incoming company/job items\nconst items = $input.all();\n\n// Build a clean array of companies/jobs\nconst companies = items.map(item => {\n  const j = item.json;\n\n  return {\n    job_id: j.job_id || \"\",\n    job_url: j.job_url || \"\",\n    job_title: j.job_title || \"\",\n    company_name: j.company_name || \"\",\n    company_url: j.company_url || \"\",\n    location: j.location || \"\",\n    seniority_level: j.seniority_level || \"\",\n    employment_type: j.employment_type || \"\",\n    time_posted: j.time_posted || \"\",\n    num_applicants: j.num_applicants || \"\",\n    salary_range: j.salary_range || null,\n    job_description: j.job_description || \"\",\n    easy_apply: j.easy_apply ?? false,\n    apply_url: j.apply_url || \"\",\n    resumeContent:$('Webhook').first().json.body.resumeContent\n  };\n});\n\n// Return ONE n8n item containing the full array\nreturn [\n  {\n    json: {\n      companies: companies,\n      count: companies.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "8ecd4278-7ba9-4fe4-963e-fb0d093b6e6b",
      "name": "Build LinkedIn Company Array"
    },
    {
      "parameters": {
        "jsCode": "// Get all incoming company/job items\nconst items = $input.all();\n\n// Build a clean array of companies/jobs\nconst companies = items.map(item => {\n  const j = item.json;\n\n  return {\n    job_id:\n      j.id ||\n      j.job_id ||\n      \"\",\n\n    job_url:\n      j.urls?.indeed ||\n      j.urls?.external ||\n      j.job_url ||\n      \"\",\n\n    job_title:\n      j.title?.text ||\n      j.job_title ||\n      \"\",\n\n    company_name:\n      j.company?.name ||\n      j.company?.displayName ||\n      j.companyName ||\n      j.company_name ||\n      \"\",\n\n    company_url:\n      j.company?.url ||\n      j.company?.companyUrl ||\n      j.company_url ||\n      \"\",\n\n    location:\n      j.location?.formatted ||\n      j.location?.formattedShort ||\n      j.location?.fullAddress ||\n      j.location ||\n      \"\",\n\n    seniority_level:\n      j.seniorityLevel ||\n      j.seniority_level ||\n      \"\",\n\n    employment_type:\n      j.jobType ||\n      j.employmentType ||\n      j.employment_type ||\n      \"\",\n\n    time_posted:\n      j.datePosted ||\n      j.postedAt ||\n      j.relativeTime ||\n      j.time_posted ||\n      \"\",\n\n    num_applicants:\n      j.numApplicants ||\n      j.num_applicants ||\n      \"\",\n\n    salary_range:\n      j.salary ||\n      j.salaryRange ||\n      j.salary_range ||\n      null,\n\n    job_description:\n      j.description?.text ||\n      j.job_description ||\n      \"\",\n\n    easy_apply:\n      j.easyApply ??\n      j.easy_apply ??\n      false,\n\n    apply_url:\n      j.urls?.apply ||\n      j.urls?.external ||\n      j.apply_url ||\n      \"\",\n\n    resumeContent:\n      $('Webhook').first().json.body.resumeContent\n  };\n});\n\n// Return ONE n8n item containing the full array\nreturn [\n  {\n    json: {\n      companies: companies,\n      count: companies.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        352
      ],
      "id": "bd2f6bf4-a889-4d9c-98b8-4aee1304fcdd",
      "name": "Build Indeed Company Array"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst jobTypeBySource = {\n  indeed: {\n    fulltime: \"fulltime\",\n    parttime: \"parttime\",\n    contract: \"contract\",\n    temporary: \"temporary\",\n    internship: \"internship\",\n    location: \"location\"\n  },\n  linkedin: {\n    fulltime: \"FULLTIME\",\n    parttime: \"PART_TIME\",\n    contract: \"CONTRACT\",\n    temporary: \"TEMPORARY\",\n    internship: \"INTERNSHIP\",\n    location: \"LOCATION\"\n  }\n};\n\nconst workPlaceBySource = {\n  indeed: {\n    hybrid: \"hybrid\",\n    remote: \"remote\"\n  },\n  linkedin: {\n    hybrid: \"HYBRID\",\n    remote: \"REMOTE\"\n  }\n};\n\nconst source = (body.jobSource || \"\").toLowerCase();\nconst rawJobType = (body.jobType || \"\").toLowerCase();\nconst rawWorkPlace = (body.workPlace || \"\").toLowerCase();\n\nconst mappedJobType = jobTypeBySource[source]?.[rawJobType] ?? body.jobType;\nconst mappedWorkPlace = workPlaceBySource[source]?.[rawWorkPlace] ?? body.workPlace;\n\nconst titles = (body.jobTitle || \"\")\n  .split(\",\")\n  .map(t => t.trim())\n  .filter(Boolean);\n\nreturn titles.map(title => ({\n  json: {\n    ...body,\n    jobTitle: title,\n    jobType: mappedJobType,\n    workPlace: mappedWorkPlace\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,

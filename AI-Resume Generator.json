    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n\n  let html = $('Message a model').all()[index].json.output[0].content[0].text;\n\n  const text = html\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n\\n')\n    .replace(/<\\/h1>/gi, '\\n\\n')\n    .replace(/<\\/h2>/gi, '\\n\\n')\n    .replace(/<\\/h3>/gi, '\\n\\n')\n    .replace(/<\\/li>/gi, '\\n')\n    .replace(/<li>/gi, '• ')\n    .replace(/<[^>]*>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .trim();\n\n  return {\n    json: {\n      text\n    }\n  };\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        0
      ],
      "id": "8a2352ea-c5e8-41e3-b86b-2eadfadd5293",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const desc = item.json.description || '';\n\n  function extractSection(text, start, end = null) {\n    const regex = end\n      ? new RegExp(`${start}[\\\\s\\\\S]*?(?=${end})`, 'i')\n      : new RegExp(`${start}[\\\\s\\\\S]*`, 'i');\n\n    const match = text.match(regex);\n    return match ? match[0].trim() : '';\n  }\n\n  const shortDescription = desc\n    .replace(/\\n+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .substring(0, 200);\n\n  const summary = desc\n    .split('\\n')\n    .slice(0, 3)\n    .join(' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  const responsibilities = extractSection(\n    desc,\n    \"What You.ll Do|Responsibilities\",\n    \"What We.re Looking For|Requirements\"\n  );\n\n  const requirements = extractSection(\n    desc,\n    \"What We.re Looking For|Requirements\",\n    \"Why This Role|Benefits\"\n  );\n\n  const benefits = extractSection(\n    desc,\n    \"Why This Role|Benefits\"\n  );\n\n  return {\n    json: {\n      ...item.json,\n      description: shortDescription,\n      JobSummary: summary,\n      Responsibilities: responsibilities,\n      Requirements: requirements,\n      Benefits: benefits\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
